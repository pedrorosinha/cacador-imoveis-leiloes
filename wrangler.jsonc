{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cacador-imoveis-leiloes",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cacador-imoveis-leiloes"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "garimpo-db",
      "database_id": "64297fb3-9c58-4aed-b349-ef2dffd1fded"
    }
  ],
  "observability": {
    "enabled": true
  }
}